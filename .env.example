# Copy to .env and fill in

# Deepgram Voice Agent (STT + TTS) — required for Space voice
DEEPGRAM_API_KEY=
# Aura / Flux speak model id
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Optional listen model (Nova/Flux)
DEEPGRAM_STT_MODEL=nova-3

# OpenRouter — agent think router + describe_scene vision
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Cheap/fast router model for the voice agent
OPENROUTER_AGENT_MODEL=openai/gpt-4o-mini
# Vision model for describe_scene (gpt-4o: strong scene vision + OCR reasoning)
OPENROUTER_MODEL=openai/gpt-4o
LLM_JPEG_MAX_SIDE=768
LLM_JPEG_QUALITY=80
LLM_MAX_TOKENS=150

# Local TTS for keyboard shortcuts (d/m/p) and boot prompt (English)
TTS_PROVIDER=edge
TTS_VOICE=en-US-JennyNeural

# Camera/render loop debug summary interval in seconds (0 disables)
FRAME_LOG_SEC=2

# Record3D capture: native (default) receives on its own thread and decodes only
# the newest frame, so the picture never lags. record3d = vendor library, which
# decodes every frame and builds up tens of seconds of lag at 1440x1920 / 60 fps.
R3D_BACKEND=native

# YOLO-World device: auto (Apple GPU if available), mps, or cpu. CPU is ~8x
# slower and pins the CPU, which throttles a fanless MacBook Air.
YOLO_DEVICE=auto
# Seconds between YOLO labeling passes (0.5 = every 30th frame at 60 fps).
# Zones and proximity beeps still run on every frame. Lower = fresher labels
# and faster car alerts, more GPU/CPU.
DETECT_INTERVAL_SEC=0.5

# Session log in logs/nekit-*.log with crash/stall forensics (0 disables)
NEKIT_LOG_FILE=1
